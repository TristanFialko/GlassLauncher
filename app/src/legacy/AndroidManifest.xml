<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- N5 legacy recovery APK: the pre-N5 WebView launcher (HOME = MainActivity) kept as a separately installable fallback.
         Same applicationId as the native production APK, so `adb install -r` swaps one for the other. -->
    <application>
        <activity android:name=".MainActivity" android:screenOrientation="landscape" android:exported="true" android:windowSoftInputMode="adjustNothing|stateHidden" android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Opt-in native UI behind MainActivity (UiRouter, Stage 4a). Not a HOME/launcher entry in this APK: MainActivity forwards
             to it with glass.ui=native, or start it with adb shell am start -n com.glasslauncher/.NativeHomeActivity (debug).
             Own process, so the WebView home never shares its memory. -->
        <activity android:name=".NativeHomeActivity" android:process=":native" android:exported="${nativeUiExported}" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" android:theme="@style/AppTheme" />
    </application>
</manifest>
